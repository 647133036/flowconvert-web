# FlowConvert 环境变量
#
# 用法: cp .env.example .env  然后填入真实值
# 服务启动时自动读取工作目录下的 .env；进程已有同名环境变量时以环境变量为准。
#
# 注意: 密钥不需要编译进二进制，运行时读取即可。

# ---------- 服务 ----------
# 监听端口
FLOWCONVERT_PORT=8080
# 数据目录（临时文件与导出文件都放在这里）
FLOWCONVERT_DATA=data
# 对外暴露的基础地址，用于生成下载链接
FLOWCONVERT_BASE_URL=http://localhost:8080

# ---------- Python 解释器 ----------
# 默认取 PATH 上的 python3。用 install.sh 创建虚拟环境时必须填绝对路径。
FLOWCONVERT_PYTHON=/absolute/path/to/flowconvert/.venv/bin/python

# ---------- AI 图片 / 视频生成（Agnes，可选） ----------
# 不填时的降级行为:
#   图片生成 -> 本地合成图片
#   视频生成 -> 本地 ffmpeg 合成视频
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.cn/v1

# ---------- SenseNova（可选） ----------
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
